# Local Docker MySQL
MYSQL_USER=koala
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_PORT=3306

# FastAPI / SQLAlchemy
DATABASE_URL=mysql+pymysql://koala:replace_with_local_password@127.0.0.1:3306/koala_db?charset=utf8mb4
JWT_SECRET_KEY=replace_with_a_long_random_secret

# External services (set only when using the corresponding feature)
OPENAI_API_KEY=
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
SEOUL_API_KEY=
TOUR_API_KEY=
CRAWLER_API_TOKEN=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Browser access. Comma-separate additional origins when needed.
FRONTEND_URL=http://localhost:5173
KOALA_CORS_ORIGINS=http://127.0.0.1:5173

# Optional persistent cache directory for place images and LLM results.
KOALA_CACHE_DIR=.runtime_cache

# Optional LLM resilience settings; omitted values use code defaults.
# LLM_TOTAL_DEADLINE_SECONDS=8
# LLM_FIRST_ATTEMPT_TIMEOUT_SECONDS=5
# LLM_RETRY_DELAY_SECONDS=0.35
# LLM_MAX_ATTEMPTS=2
# LLM_CIRCUIT_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_OPEN_SECONDS=30
# LLM_RESULT_CACHE_ENABLED=true
# LLM_RESULT_CACHE_TTL_SECONDS=86400
# LLM_RESULT_CACHE_PATH=.runtime_cache/intent_result_cache.sqlite3
# LLM_RUNTIME_LOG_PATH=
