      "type": [
        "string",
        "null"
      ]
    },
    "target_location_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_location_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "area",
        "place",
        null
      ]
    },
    "end_location_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "end_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "start_time_period": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "morning",
        "lunch",
        "evening",
        "am",
        "pm",
        null
      ]
    },
    "end_time_period": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "morning",
        "lunch",
        "evening",
        "am",
        "pm",
        null
      ]
    },
    "desired_duration_min_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "desired_duration_max_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "food",
          "cafe",
          "walk",
          "culture",
          "entertainment",
          "shopping",
          "drink"
        ]
