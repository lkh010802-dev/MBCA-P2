{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/team-llm-structured-output-v1.json",
  "title": "Team LLM Natural Language Structured Output V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "start_location_text",
    "end_location_text",
    "start_time",
    "end_time",
    "desired_duration_minutes",
    "activities",
    "transport_mode",
    "companions",
    "budget_max",
    "budget_preference",
    "space_preference"
  ],
  "properties": {
    "start_location_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "end_location_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "end_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "desired_duration_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "activities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "food",
          "cafe",
          "walk",
          "culture",
          "entertainment",
          "shopping",
          "drink"
        ]
      }
    },
    "transport_mode": {
      "type": "string",
      "enum": [
        "auto",
        "public_transit",
        "walk",
        "car"
      ]
    },
    "companions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "solo",
          "friend",
          "partner",
          "family",
          "child",
          "coworker"
        ]
      }
    },
    "budget_max": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "budget_preference": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "flexible",
        "any",
        null
      ]
    },
    "space_preference": {
      "type": ["string", "null"],
      "enum": ["indoor", "outdoor", "any", null],
      "description": "사용자가 명시한 실내/야외 공간 선호"
    }
  }
}